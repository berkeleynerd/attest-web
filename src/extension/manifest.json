{
  "manifest_version": 3,
  "name": "Attested Web",
  "version": "0.1.0",
  "description": "Verifies attest-signed HTML artifacts.",
  "permissions": [
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html"
  }
}
